{
  "name": "fly",
  "version": "0.1.0",
  "private": true,
  "description": "Fly - React reconciler renderer that outputs JSON DSL and dispatches to Flutter via QuickJS",
  "main": "dist/bundle.js",
  "scripts": {
    "build": "node esbuild.js",
    "dev": "node esbuild.js --watch",
    "start": "node debug_server.js",
    "bundle:pack": "node scripts/bundle-pack.js",
    "bundle:pack:copy": "node scripts/bundle-pack.js --copy",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "fuickjs": "file:../../fuickjs_framework/fuickjs",
    "react": "^19.2.0",
    "react-reconciler": "^0.33.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "esbuild": "^0.21.4",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "ws": "^8.19.0"
  }
}
